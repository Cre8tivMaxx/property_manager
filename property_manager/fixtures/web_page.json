  "main_section_html": "<style>\n.osus-home {\n    direction: rtl;\n    text-align: right;\n    color: #344854;\n    padding-bottom: 35px;\n}\n.osus-home * { box-sizing: border-box; }\n.osus-home .osus-hero {\n    background:\n        linear-gradient(270deg, rgba(12,36,77,.94), rgba(12,36,77,.45)),\n        url('/files/B01.jpg') center 40% / cover;\n    border-radius: 22px;\n    padding: 65px 40px;\n    color: white;\n    margin: 20px 0 35px;\n}\n.osus-home .osus-hero h1 {\n    color: white;\n    font-size: clamp(30px, 4vw, 48px);\n    font-weight: 800;\n    line-height: 1.5;\n    margin: 0 0 15px;\n}\n.osus-home .osus-hero p {\n    font-size: 19px;\n    line-height: 1.9;\n    max-width: 620px;\n    color: #edf2fa;\n}\n.osus-home .osus-actions {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 12px;\n    margin-top: 25px;\n}\n.osus-home .osus-button {\n    display: inline-block;\n    padding: 12px 24px;\n    border-radius: 9px;\n    text-decoration: none;\n    font-weight: 700;\n    background: #1ba878;\n    color: white;\n}\n.osus-home .osus-button.secondary {\n    background: white;\n    color: #173a86;\n}\n.osus-home .osus-button:hover {\n    filter: brightness(.94);\n}\n.osus-home a:focus-visible {\n    outline: 3px solid #39d6a0;\n    outline-offset: 4px;\n}\n.osus-home h2 {\n    color: #173a86;\n    font-size: 28px;\n    font-weight: 800;\n    margin: 30px 0 18px;\n}\n.osus-home .osus-services {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 18px;\n}\n.osus-home .osus-service {\n    background: #f5f8fc;\n    border: 1px solid #e3eaf3;\n    border-top: 4px solid #1ba878;\n    border-radius: 14px;\n    padding: 24px;\n}\n.osus-home .osus-service h3 {\n    color: #173a86;\n    font-size: 20px;\n    font-weight: 700;\n    margin: 0 0 12px;\n}\n.osus-home .osus-service p {\n    margin: 0;\n    line-height: 1.9;\n}\n.osus-home .osus-buildings {\n    display: grid;\n    grid-template-columns: repeat(5, minmax(0, 1fr));\n    gap: 16px;\n}\n.osus-home .osus-building {\n    margin: 0;\n    overflow: hidden;\n    border: 1px solid #e3eaf3;\n    border-radius: 14px;\n    background: white;\n    box-shadow: 0 5px 16px rgba(20,40,80,.06);\n}\n.osus-home .osus-building img {\n    display: block;\n    width: 100%;\n    height: 180px;\n    object-fit: cover;\n}\n.osus-home .osus-building figcaption {\n    padding: 15px 10px;\n    text-align: center;\n    color: #173a86;\n    font-weight: 700;\n}\n.osus-home .osus-end {\n    text-align: center;\n    margin-top: 35px;\n    padding: 25px;\n    border-radius: 14px;\n    background: #f5f8fc;\n}\n@media (max-width: 900px) {\n    .osus-home .osus-buildings {\n        grid-template-columns: repeat(3, minmax(0, 1fr));\n    }\n}\n@media (max-width: 600px) {\n    .osus-home .osus-hero { padding: 35px 22px; }\n    .osus-home .osus-services { grid-template-columns: 1fr; }\n    .osus-home .osus-buildings {\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n    .osus-home .osus-building img { height: 150px; }\n}\n\n.osus-home .osus-feature-groups { margin-top: 40px; }\n.osus-home .osus-feature-group { padding: 32px 0; }\n.osus-home .osus-feature-group + .osus-feature-group {\n    border-top: 1px solid #e3eaf3;\n    margin-top: 12px;\n}\n.osus-home .osus-feature-group h2 { margin: 0 0 10px; }\n.osus-home .osus-group-description {\n    color: #607080;\n    font-size: 17px;\n    line-height: 1.9;\n    margin: 0 0 24px;\n}\n.osus-home .osus-feature-group .osus-service { height: 100%; }\n</style>\n\n<div class=\"osus-home\" lang=\"ar\">\n\n    <section class=\"osus-hero\">\n        <h1>أسس لإدارة العقارات<br>وضوح في الإدارة، وراحة في السكن</h1>\n        <p>\n            إدارة المباني والوحدات السكنية والعقود والتحصيل،\n            في تجربة منظمة وسهلة.\n        </p>\n        <div class=\"osus-actions\">\n            <a class=\"osus-button\" href=\"#osus-properties\">\n                استكشف مبانينا\n            </a>\n            <a class=\"osus-button secondary\" href=\"/login\">\n                تسجيل الدخول\n            </a>\n            <a class=\"osus-button\" href=\"/login#signup\">\n                إنشاء حساب\n            </a>\n        </div>\n    </section>\n\n    <div class=\"osus-feature-groups\">\n        <h2 style=\"font-size: 34px; margin-bottom: 12px;\">\n    مزايا تتجاوز إدارة الإيجارات\n</h2>\n<p class=\"osus-group-description\">\n    من إدارة الوحدات والعقود إلى الحسابات والأصول والصيانة،\n    أعمالك مترابطة في منظومة واحدة.\n</p>\n\n    <!-- القسم الأول -->\n    <section class=\"osus-feature-group\">\n        <h2>إدارة العقارات والتشغيل</h2>\n        <p class=\"osus-group-description\">\n            تفاصيل المباني والوحدات والتجهيزات والصيانة في مكان واحد.\n        </p>\n\n        <div class=\"osus-services\">\n\n            <article class=\"osus-service\">\n                <h3>وصف تفصيلي لكل وحدة</h3>\n                <p>\n                    توثيق موقع الوحدة ودورها ومساحتها والغرف\n                    والمرافق والخدمات المتاحة بها،\n                    مع الصور وحالة التأثيث.\n                </p>\n            </article>\n\n            <article class=\"osus-service\">\n                <h3>رسوم الخدمات مرتبطة بالعقد</h3>\n                <p>\n                    ربط رسوم الكهرباء والمياه والصيانة بعقد\n                    الوحدة، وإضافتها إلى الفواتير وفق\n                    دورية كل خدمة.\n                </p>\n            </article>\n\n            <article class=\"osus-service\">\n                <h3>سجل متكامل للمباني والأصول</h3>\n                <p>\n                    تسجيل بيانات المبنى وموقعه وتفاصيله وقيمته،\n                    مع احتساب الإهلاك وترحيله تلقائيًا وفق\n                    السياسة المحاسبية والإعدادات المعتمدة.\n                </p>\n            </article>\n\n            <article class=\"osus-service\">\n                <h3>الأثاث والعهد لكل وحدة</h3>\n                <p>\n                    حصر قطع الأثاث والتجهيزات بكل وحدة،\n                    ومتابعة موقعها وحالتها وقيمتها وإهلاك\n                    القطع المسجلة كأصول ثابتة.\n                </p>\n            </article>\n\n            <article class=\"osus-service\">\n                <h3>الصيانة الدورية للمباني والتجهيزات</h3>\n                <p>\n                    تنظيم جداول الصيانة الوقائية، وتحديد\n                    المسؤولين عنها ومواعيد تنفيذها،\n                    والاحتفاظ بسجل أعمال الصيانة.\n                </p>\n            </article>\n\n            <article class=\"osus-service\">\n                <h3>مخزون قطع غيار الصيانة</h3>\n                <p>\n                    تنظيم مستودع قطع الغيار ومستلزمات الصيانة،\n                    ومتابعة الأرصدة والاستلام والصرف\n                    وحدود إعادة الطلب.\n                </p>\n            </article>\n\n        </div>\n    </section>\n\n    <!-- القسم الثاني -->\n    <section class=\"osus-feature-group\">\n        <h2>الإدارة المالية والرقابة</h2>\n        <p class=\"osus-group-description\">\n            رؤية واضحة للتحصيل والمستحقات، وأدوات تدعم الرقابة المالية.\n        </p>\n\n        <div class=\"osus-services\">\n\n            <article class=\"osus-service\">\n                <h3>موقف مالي واضح لكل وحدة</h3>\n                <p>\n                    متابعة قيمة العقد والمبالغ المحصلة\n                    والمتبقية والإيجارات المتأخرة،\n                    بناءً على الحركات المسجلة.\n                </p>\n            </article>\n\n            <article class=\"osus-service\">\n                <h3>التأمين والتحصيل تحت المتابعة</h3>\n                <p>\n                    متابعة التأمين المحصل والمبالغ المردودة\n                    والخصومات، مع الوصول إلى سندات\n                    قبض العقد.\n                </p>\n            </article>\n\n            <article class=\"osus-service\">\n                <h3>الموازنات التقديرية والرقابة</h3>\n                <p>\n                    إعداد موازنات المصروفات حسب مراكز التكلفة\n                    أو المشاريع، ومقارنة الفعلي بالمخطط\n                    ومتابعة الانحرافات.\n                </p>\n            </article>\n\n            <article class=\"osus-service\">\n                <h3>الفوترة الإلكترونية وزاتكا</h3>\n                <p>\n                    دعم إصدار الفواتير الإلكترونية والربط\n                    مع هيئة الزكاة والضريبة والجمارك،\n                    وفق إعدادات المنشأة ومتطلبات التكامل.\n                </p>\n            </article>\n\n        </div>\n    </section>\n\n    <!-- القسم الثالث -->\n    <section class=\"osus-feature-group\">\n        <h2>منظومة متكاملة ودعم مستمر</h2>\n        <p class=\"osus-group-description\">\n            نظام يجمع أعمالك، ومساندة تساعد فريقك على الاستخدام بثقة.\n        </p>\n\n        <div class=\"osus-services\">\n\n            <article class=\"osus-service\">\n                <h3>شركات وأنشطة متعددة</h3>\n                <p>\n                    إدارة عدة شركات وأنشطة داخل نظام واحد،\n                    مع حسابات وصلاحيات مستقلة\n                    لكل شركة.\n                </p>\n            </article>\n\n            <article class=\"osus-service\">\n                <h3>عملات ولغات متعددة</h3>\n                <p>\n                    التعامل بعملات مختلفة، وإتاحة واجهة\n                    النظام بالعربية والإنجليزية\n                    ولغات أخرى.\n                </p>\n            </article>\n\n            <article class=\"osus-service\">\n                <h3>يعتمد على ERPNext العالمي</h3>\n                <p>\n                    مبني على نظام ERPNext ،\n                    لربط إدارة العقارات بالمحاسبة والمشتريات\n                    والمخزون والأصول في منظومة واحدة.\n                </p>\n            </article>\n\n            <article class=\"osus-service\">\n                <h3>دعم فني خلال ساعات العمل</h3>\n                <p>\n                    مساندة المستخدمين والإجابة عن استفساراتهم\n                    ومتابعة المشكلات عبر قنوات الدعم\n                    المعتمدة طوال ساعات العمل.\n                </p>\n            </article>\n\n            <article class=\"osus-service\">\n                <h3>شروحات تساعدك في كل خطوة</h3>\n                <p>\n                    شروحات عملية على يوتيوب توضح خطوات\n                    استخدام النظام، ويمكن الرجوع إليها\n                    لتسهيل التعلم والعمل اليومي.\n                </p>\n            </article>\n\n        </div>\n    </section>\n\n\n    </div><!-- /osus-feature-groups -->\n\n    <section id=\"osus-properties\">\n        <h2>استكشف مبانينا</h2>\n        <div class=\"osus-buildings\">\n            <figure class=\"osus-building\">\n                <img src=\"/files/B01.jpg\" alt=\"المبنى الأول\" loading=\"lazy\">\n                <figcaption>المبنى الأول — B01</figcaption>\n            </figure>\n\n            <figure class=\"osus-building\">\n                <img src=\"/files/B02.jpg\" alt=\"المبنى الثاني\" loading=\"lazy\">\n                <figcaption>المبنى الثاني — B02</figcaption>\n            </figure>\n\n            <figure class=\"osus-building\">\n                <img src=\"/files/B03.jpg\" alt=\"المبنى الثالث\" loading=\"lazy\">\n                <figcaption>المبنى الثالث — B03</figcaption>\n            </figure>\n\n            <figure class=\"osus-building\">\n                <img src=\"/files/B04.jpg\" alt=\"المبنى الرابع\" loading=\"lazy\">\n                <figcaption>المبنى الرابع — B04</figcaption>\n            </figure>\n\n            <figure class=\"osus-building\">\n                <img src=\"/files/B05.jpg\" alt=\"المبنى الخامس\" loading=\"lazy\">\n                <figcaption>المبنى الخامس — B05</figcaption>\n            </figure>\n        </div>\n    </section>\n\n    <div class=\"osus-end\">\n        <p>للوصول إلى حسابك والخدمات المتاحة لك</p>\n        <a class=\"osus-button\" href=\"/login\">تسجيل الدخول</a>\n    </div>\n\n</div>",
